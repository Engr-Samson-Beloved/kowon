# ==============================================================================
# KÓ WON ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env.local' (for local development) and fill in the values.
# ==============================================================================

# 1. SUPABASE DATABASE & AUTHENTICATION
# Obtain these from: Supabase Console > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# 2. PRISMA DATABASE MIGRATION URLS
# Transaction mode (port 6543) - used for Prisma client queries.
# Session mode (port 5432) - used for Prisma migrations.
# Obtain these from: Supabase Console > Project Settings > Database > Connection Strings
DATABASE_URL="postgresql://postgres:your-db-password@db.your-project-id.supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres"

# 3. PAYSTACK LOCAL PAYMENT GATEWAY (NIGERIA)
# Used for locking client escrow deposits and releasing payouts to student bank accounts.
# Obtain these from: Paystack Dashboard > Settings > API Keys & Webhooks
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here

# 4. NEXT.JS DEPLOYMENT & METADATA
# Base URL for OG image previews and canonical SEO crawling
NEXT_PUBLIC_BASE_URL=https://kowon.com.ng
NEXTAUTH_SECRET=your-random-jwt-signing-secret-key-here
